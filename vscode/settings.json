{
	// ============================================================
	// 编辑器基础体验
	// ============================================================
	"editor.accessibilitySupport": "off",
	"editor.cursorBlinking": "phase",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.fontFamily": "CodeNewRoman Nerd Font Mono, JetBrains Mono Nerd Font light, Fira Code Retina, Maple Mono Normal NF CN, Monaco, monospace",
	"editor.fontLigatures": true,
	"editor.fontSize": 17,
	"editor.largeFileOptimizations": true,
	"editor.lineHeight": 24,
	"editor.linkedEditing": true,
	"editor.lineNumbers": "on",
	"editor.minimap.enabled": false,
	"editor.tabCompletion": "on",
	"editor.wordWrap": "on",
	"editor.inlineSuggest.enabled": true,

	// ============================================================
	// 保存与格式化
	// ============================================================
	"files.autoSave": "onFocusChange",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {},

	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[dockerfile]": {
		"editor.quickSuggestions": {
			"strings": true
		}
	},
	"[graphql]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[markdown]": {
		"editor.defaultFormatter": "yzhang.markdown-all-in-one",
		"editor.formatOnSave": true,
		"editor.wordWrap": "on"
	},
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.ruff": "always",
			"source.organizeImports.ruff": "always"
		}
	},
	"[terraform]": {
		"editor.defaultFormatter": "hashicorp.terraform"
	},
	"[terraform-vars]": {
		"editor.defaultFormatter": "hashicorp.terraform"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},

	// ============================================================
	// Markdown
	// ============================================================
	"markdown.preview.lineHeight": 1.1,
	"markdown.copyFiles.destination": {
		"**/*": "${documentDirName}/"
	},
	"markdown.extension.toc.updateOnSave": true,
	"markdown.extension.tableFormatter.enabled": true,

	// ============================================================
	// 文件管理与文件关联
	// ============================================================
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"workbench.editor.empty.hint": "hidden",
	"workbench.editorAssociations": {
		"*.dio": "hediet.vscode-drawio",
		"*.drawio": "hediet.vscode-drawio",
		"*.drawio.png": "hediet.vscode-drawio",
		"*.drawio.svg": "hediet.vscode-drawio"
	},

	// ============================================================
	// 终端与语言工具
	// ============================================================
	"terminal.external.osxExec": "Ghostty.app",
	"terminal.integrated.env.osx": {
		"Q_NEW_SESSION": "1"
	},
	"terminal.integrated.fontFamily": "Maple Mono Normal NF CN, monospace",
	"terminal.integrated.fontSize": 14,
	"terminal.integrated.inheritEnv": true,
	"python.languageServer": "Default",
	"python.pyrefly.typeCheckingMode": "auto",

	// ============================================================
	// Git
	// ============================================================
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.openRepositoryInParentFolders": "always",

	// ============================================================
	// Copilot 内联建议
	// ============================================================
	"github.copilot.enable": {
		"*": true,
		"markdown": true,
		"plaintext": false,
		"scminput": false
	},
	// ============================================================
	// Chat 与 AI 界面
	// ============================================================
	"chat.tips.enabled": false,
	"chat.agentsControl.enabled": "hidden",
	"chat.viewSessions.enabled": false,
	"chat.viewSessions.orientation": "stacked",
	"chat.titleBar.openInAgentsWindow.enabled": false,
	"chatgpt.composerEnterBehavior": "cmdIfMultiline",
	"chatgpt.reviewDelivery": "detached",

	// ============================================================
	// 界面与主题
	// ============================================================
	"window.commandCenter": true,
	"workbench.startupEditor": "none",
	"workbench.browser.showInTitleBar": true,
	"workbench.colorTheme": "One Dark Pro Night Flat",
	"workbench.iconTheme": "symbols",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"workbench.tree.indent": 15,
	"workbench.tree.renderIndentGuides": "always",
	"workbench.colorCustomizations": {
		"tree.indentGuidesStroke": "#05ef3c"
	},

	// ============================================================
	// Docker、Remote 与 Azure
	// ============================================================
	"docker.extension.enableComposeLanguageServer": false,
	"docker.extension.dockerEngineAvailabilityPrompt": false,
	"remote.SSH.connectTimeout": 120,
	"azureResourceGroups.selectedSubscriptions": [
		"462a9c9c-2da6-4bfb-b318-0f83043fe49b/7dcd53d4-565b-4316-b311-793ed9bc0f16"
	],

	// ============================================================
	// Draw.io
	// ============================================================
	"hediet.vscode-drawio.resizeImages": null,
	"hediet.vscode-drawio.theme": "kennedy",
	"hediet.vscode-drawio.appearance": "automatic",

	// ============================================================
	// YAML
	// ============================================================
	"yaml.disableSchemaDetection": [
		"**/.github/workflows/*.yml",
		"**/.github/workflows/*.yaml",
		"**/.gitea/workflows/*.yml",
		"**/.gitea/workflows/*.yaml",
		"**/.forgejo/workflows/*.yml",
		"**/.forgejo/workflows/*.yaml"
	],

	// ============================================================
	// 隐私、安全与更新
	// ============================================================
	"security.workspace.trust.untrustedFiles": "open",
	"telemetry.telemetryLevel": "off",
	"redhat.telemetry.enabled": false,
	"update.showReleaseNotes": false,

	// ============================================================
	// JSON Schema 信任域
	// ============================================================
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://developer.microsoft.com/json-schemas/": true,
		"https://biomejs.dev": true
	},

	// ============================================================
	// Notebook
	// ============================================================
	"notebook.multiCursor.enabled": true
}